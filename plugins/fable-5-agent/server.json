{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.llmotions.farm/fable-5-agent",
  "title": "Fable 5 Agent",
  "description": "Authenticated async Fable 5 coding agent with status polling and artifact results.",
  "version": "0.1.0",
  "websiteUrl": "https://farm.llmotions.com/marketplaces/agents/fable-5-agent/mcp/access",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://farm.llmotions.com/mcp/agents/fable-5-agent",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {agentfarm_token}",
          "variables": {
            "agentfarm_token": {
              "description": "Paid AgentFarm MCP token from the access URL",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
